# Copie este arquivo para ".env" e preencha com valores reais antes de rodar o docker-compose.
# NUNCA faca commit do arquivo ".env" preenchido em um repositorio publico.


# Credenciais do schema/usuario da aplicacao no PostgreSQL
DB_USERNAME=residuos_user
DB_PASSWORD=<DEFINA_UMA_SENHA_FORTE>

# Chave secreta usada para assinar os tokens JWT (use uma string longa e aleatoria)
JWT_SECRET=<DEFINA_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA>
JWT_EXPIRATION_MS=3600000
